<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the OpenWA dashboard (static SPA) + reverse proxy to the
  NestJS API. This file is placed in dashboard/public so Vite copies it into
  dashboard/dist on `npm run build`. The dist folder is the IIS site root.

  Requires on the server:
    - IIS with the "WebSocket Protocol" role feature
    - URL Rewrite module 2.1
    - Application Request Routing (ARR) 3.0 with proxy enabled
  Mirrors dashboard/nginx.conf:
    /api/*       -> http://localhost:2785
    /socket.io/* -> http://localhost:2785 (WebSocket)
    everything else -> SPA fallback to /index.html
-->
<configuration>
  <system.webServer>
    <!--
      Disable IIS's own WebSocket module for this site. Otherwise IIS intercepts
      the WebSocket handshake and computes its own Sec-WebSocket-Accept, which
      breaks Socket.IO upgrades proxied through ARR ("Incorrect
      'Sec-WebSocket-Accept' header value"). With this off, ARR tunnels the raw
      WebSocket frames straight to the Node backend.
    -->
    <webSocket enabled="false" />

    <rewrite>
      <rules>
        <!-- Proxy API + Socket.IO traffic to the Node backend -->
        <rule name="ReverseProxyToApi" stopProcessing="true">
          <match url="^(api|socket\.io)/(.*)" />
          <action type="Rewrite" url="http://localhost:2785/{R:1}/{R:2}" />
        </rule>

        <!-- SPA fallback: anything that isn't a real file/dir -> index.html -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Ensure modern asset types are served correctly -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/json" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <!-- Don't let IIS serve a custom error page for proxied API errors -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
